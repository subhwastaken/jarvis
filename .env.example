# J.A.R.V.I.S. Environment Variables Template
# Copy this file to .env and fill in your keys (or use the built-in Keys UI panel)

# NVIDIA NIM API Key (Powers ultra-fast intent classification & LLM reasoning)
NVIDIA_API_KEY=

# TypeSafe API Key (Fast single-turn speculative intent parser)
TYPESAFE_API_KEY=

# Fish Audio API Key (Neural emotional TTS voice synthesis)
FISH_AUDIO_API_KEY=

# OpenRouter API Key (Optional: fallback LLM questions)
OPENROUTER_API_KEY=
